# Exact versions only (renovate.json sets rangeStrategy pin to match).
save-exact=true
# Fail install when a package's "engines" field does not match this Node.
engine-strict=true
# The flake pins pnpm; never let pnpm 10 self-download the packageManager
# version (hack/check-versions.sh asserts the two agree).
manage-package-manager-versions=false
